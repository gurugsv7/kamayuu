NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Public hCaptcha sitekey. The hCaptcha SECRET is never stored here — it goes
# into Supabase: Authentication -> Attack Protection -> CAPTCHA.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
# Public Google OAuth client id (Web application, from Google Cloud Console).
# No client secret is needed for the Identity Services / signInWithIdToken flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
