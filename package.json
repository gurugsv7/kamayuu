{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/engine.test.mjs tests/multiplayer.test.mjs tests/multiplayer-transport.test.mjs tests/ranked.test.mjs tests/ranked-runtime.test.mjs tests/ranked-service.test.mjs tests/rival-personality.test.mjs tests/ranked-transport.test.mjs tests/family.test.mjs tests/mobile.test.mjs tests/turn-timing.test.mjs tests/ranked-feedback.test.mjs tests/turn-motion.test.mjs tests/rank-display.test.mjs tests/table-session.test.mjs tests/artwork-cache.test.mjs tests/reviewer-auth.test.mjs tests/captcha.test.mjs",
    "test:family:db": "node --test tests/family-database.test.mjs",
    "test:ranked:db": "node --test tests/ranked-database.test.mjs tests/ranked-worker-auth.test.mjs",
    "sync:edge": "node scripts/sync-edge.mjs",
    "worker:ranked": "node scripts/ranked-worker.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "build:vercel": "vite build --config vite.config.vercel.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "build:mobile": "vite build --config vite.config.vercel.ts --mode mobile",
    "android:sync": "npm run build:mobile && cap sync android",
    "dev:mobile": "vite --config vite.config.vercel.ts --mode mobile",
    "preview:mobile": "vite preview --config vite.config.vercel.ts --mode mobile"
  },
