{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist-vercel",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/how-to-play",
      "destination": "/how-to-play/index.html"
    },
    {
      "source": "/credits",
      "destination": "/credits/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
